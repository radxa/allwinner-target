software =
{
    version = "0.1.0";
    description = "Firmware update for aiot Project";

    stable = {

        /* ------------------------- For ufs -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_ufs = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootB";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootA"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsB";
                    properties: {
                        rdiffbase = ["/dev/by-name/rootfsA"];
                    };
                },*/
                {
                    filename = "uboot";
                    device = "/dev/sda";
                    offset = "16400K"
                    installed-directly = true;
                },
                {
                    /*firset boot0 in 16 sector, second boot0 in 2064 sector*/
                    filename = "boot0_ufs";
                    device = "/dev/sda";
                    offset = "8K"
                    installed-directly = true;
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_ufs = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootA";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootB"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsA";
                    properties: {
                        rdiffbase = ["/dev/by-name/rootfsB"];
                    };
                },*/
                {
                    filename = "uboot";
                    device = "/dev/sda";
                    offset = "16400K"
                    installed-directly = true;
                },
                {
                    /*firset boot0 in 16 sector, second boot0 in 2064 sector*/
                    filename = "boot0_ufs";
                    device = "/dev/sda";
                    offset = "8K"
                    installed-directly = true;
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* ------------------------- For Rawnand -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_rawnand = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootB";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootA"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsB";
                    properties: {
                        rdiffbase = ["/dev/by-name/rootfsA"];
                    };
                },*/
                {
                    filename = "uboot";
                    type = "awuboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_rawnand = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootA";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootB"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsA";
                    properties: {
                        rdiffbase = ["/dev/by-name/rootfsB"];
                    };
                },*/
                {
                    filename = "uboot";
                    type = "awuboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* ------------------------- For ubinand -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_ubinand = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootB_fifo";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootA"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsB_fifo";
                    properties: {
                        rdffbase = ["/dev/by-name/rootfsA"];
                    };
                },*/
                {
                    filename = "uboot";
                    type = "awuboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                }
            );

            scripts: (
                {
                    filename = "preinstall_B.sh";
                    type = "preinstall";
                },
                {
                    filename = "postinstall_B.sh";
                    type = "postinstall";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_ubinand = {
            images: (
                {
                    filename = "kernel.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/bootA_fifo";
                    properties: {
                        rdiffbase = ["/dev/by-name/bootB"];
                    };
                },
                /*{
                    filename = "rootfs.rdiff.delta";
                    type = "rdiff_image";
                    device = "/dev/by-name/rootfsA_fifo";
                    properties: {
                        rdiffbase = ["/dev/by-name/rootfsB"];
                    };
                },*/
                {
                    filename = "uboot";
                    type = "awuboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }
    }

    /* when not call with -e xxx,xxx    just clean */
    bootenv: (
        {
            name = "swu_param";
            value = "";
        },
        {
            name = "swu_software";
            value = "";
        },
        {
            name = "swu_mode";
            value = "";
        },
        {
            name = "swu_version";
            value = "";
        }
    );

}
