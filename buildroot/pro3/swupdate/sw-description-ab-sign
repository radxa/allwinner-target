software =
{
    version = "0.1.0";
    description = "Firmware update for aiot Project";

    stable = {

        /* ------------------------- For ufs -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_ufs = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootB";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsB";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    device = "/dev/sda";
                    offset = "16400K"
                    sha256 = "@uboot";
                    installed-directly = true;
                },
                {
                    /*firset boot0 in 16 sector, second boot0 in 2064 sector*/
                    filename = "boot0_ufs";
                    device = "/dev/sda";
                    offset = "8K"
                    sha256 = "@boot0_ufs";
                    installed-directly = true;
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_ufs = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootA";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsA";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    device = "/dev/sda";
                    offset = "16400K"
                    sha256 = "@uboot";
                    installed-directly = true;
                },
                {
                    /*firset boot0 in 16 sector, second boot0 in 2064 sector*/
                    filename = "boot0_ufs";
                    device = "/dev/sda";
                    offset = "8K"
                    sha256 = "@boot0_ufs";
                    installed-directly = true;
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* ------------------------- For Rawnand -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_rawnand = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootB";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsB";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    type = "awuboot";
                    sha256 = "@uboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                    sha256 = "@boot0_nand";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_rawnand = {
            images: (
                {
                    filename = "kernel";
                    device = "/dev/by-name/bootA";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    device = "/dev/by-name/rootfsA";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    type = "awuboot";
                    sha256 = "@uboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                    sha256 = "@boot0_nand";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* ------------------------- For ubinand -------------------------*/
        /* now in systemA, we need to upgrade systemB(bootB, rootfsB) */
        now_A_next_B_ubinand = {
            images: (
                {
                    filename = "kernel";
                    volume = "bootB";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    volume = "rootfsB";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    type = "awuboot";
                    sha256 = "@uboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                    sha256 = "@boot0_nand";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootB";
                },
                {
                    name = "root_partition";
                    value = "rootfsB";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }

        /* now in systemB, we need to upgrade systemA(bootA, rootfsA) */
        now_B_next_A_ubinand = {
            images: (
                {
                    filename = "kernel";
                    volume = "bootA";
                    sha256 = "@kernel";
                    installed-directly = true;
                },
                {
                    filename = "rootfs";
                    volume = "rootfsA";
                    sha256 = "@rootfs";
                    installed-directly = true;
                },
                {
                    filename = "uboot";
                    type = "awuboot";
                    sha256 = "@uboot";
                },
                {
                    filename = "boot0_nand";
                    type = "awboot0";
                    sha256 = "@boot0_nand";
                }
            );

            bootenv: (
                {
                    name = "swu_mode";
                    value = "";
                },
                {
                    name = "boot_partition";
                    value = "bootA";
                },
                {
                    name = "root_partition";
                    value = "rootfsA";
                },
                {
                    name = "swu_next";
                    value = "reboot";
                }
            );
        }
    }

    /* when not call with -e xxx,xxx    just clean */
    bootenv: (
        {
            name = "swu_param";
            value = "";
        },
        {
            name = "swu_software";
            value = "";
        },
        {
            name = "swu_mode";
            value = "";
        },
        {
            name = "swu_version";
            value = "";
        }
    );

}
